3 questao:
n = int(input("Quantos números deseja inserir? "))

if n > 0:
    soma = 0
    maior = float('-inf')
    menor = float('inf')
    
    for i in range(n):
        while True:
            num = float(input(f"Digite o {i+1}º número (entre 0 e 1000): "))
            if 0 <= num <= 1000:
                break
            print("Valor inválido. Digite apenas números entre 0 e 1000.")
            
        soma += num
        if num > maior: maior = num
        if num < menor: menor = num
            
    print(f"Menor valor: {menor}")
    print(f"Maior valor: {maior}")
    print(f"Soma dos valores: {soma}")

